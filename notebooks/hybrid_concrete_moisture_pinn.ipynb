import torch
import torch.nn as nn
import torch.optim as optim
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
from torch.utils.data import Dataset, DataLoader
import time
import os
from collections import defaultdict
import warnings
warnings.filterwarnings('ignore')

# Set device
device = torch.device('cuda' if torch.cuda.is_available() else 'cpu')
print(f"Using device: {device}")

# Hyperparameters - OPTIMIZED FOR FASTER TRAINING
EPOCHS = 150  # Increased slightly for hybrid learning
LEARNING_RATE = 2e-3
BATCH_SIZE = 32
N_DEPTH_POINTS = 30
DOMAIN_LENGTH = 0.1  # 10cm depth

# Physics loss weights
LAMBDA_PDE = 1.0
LAMBDA_BC = 5.0
LAMBDA_IC = 5.0
LAMBDA_DATA = 50.0

# Physical constants
RHO_EAU = 1000.0
S_C = 0.8
S_CAP = 0.75
BETA = 2.5
PC0 = 5e6
K_IN = 1.7e-20
ETA_L = 1e-3

# NEW: Environmental parameters
RH_DRYING = 0.5  # 50% RH for drying conditions
RH_WETTING = 0.95  # 95% RH for wetting/saturation conditions


class HybridConcreteDataset(Dataset):
    """
    UPGRADED Dataset for concrete moisture data with BOTH drying and wetting sequences
    
    Key improvements:
    - Automatically detects drying vs wetting sequences
    - Adds environmental RH as input feature
    - Computes surface saturation from RH
    - Handles bidirectional moisture transport
    """
    
    def __init__(self, csv_file, domain_length=DOMAIN_LENGTH, n_depth_points=N_DEPTH_POINTS):
        self.df = pd.read_csv(csv_file)
        self.domain_length = domain_length
        self.n_depth_points = n_depth_points
        
        # NEW: Identify sequence types (drying vs wetting)
        self.identify_sequences()
        
        # Normalize inputs
        self.normalize_inputs()
        
        # Create depth points for integral computation
        self.x_integral = torch.linspace(0, domain_length, n_depth_points, device=device)
        
        # Group by mix for easier processing
        self.mix_groups = self.df.groupby('Mix')
        self.mix_names = list(self.mix_groups.groups.keys())
        
        print(f"Loaded {len(self.df)} data points from {len(self.mix_names)} mixes")
        print(f"  - Drying sequences: {(self.df['sequence_type'] == 'drying').sum()}")
        print(f"  - Wetting sequences: {(self.df['sequence_type'] == 'wetting').sum()}")
        print(f"Time range: {self.df['Time_d'].min():.1f} - {self.df['Time_d'].max():.1f} days")
        print(f"S_frac range: {self.df['S_frac'].min():.3f} - {self.df['S_frac'].max():.3f}")
    
    def identify_sequences(self):
        """
        NEW METHOD: Identify drying vs wetting sequences from the data
        
        Logic:
        - For each mix, sort by time
        - If S_frac decreases over time → drying
        - If S_frac increases over time → wetting
        - Can handle multiple cycles within same mix
        """
        self.df['sequence_type'] = 'unknown'
        self.df['surface_RH'] = 0.5  # Default
        self.df['S_surface_target'] = 0.5  # Default equilibrium saturation
        
        for mix_name in self.df['Mix'].unique():
            mix_mask = self.df['Mix'] == mix_name
            mix_data = self.df[mix_mask].sort_values('Time_d')
            
            # Calculate rate of change in saturation
            if len(mix_data) > 1:
                S_values = mix_data['S_frac'].values
                time_values = mix_data['Time_d'].values
                
                # Use rolling window to identify phases
                window_size = min(3, len(S_values))
                
                for i in range(len(mix_data)):
                    idx = mix_data.index[i]
                    
                    # Look at local trend
                    start_idx = max(0, i - window_size//2)
                    end_idx = min(len(S_values), i + window_size//2 + 1)
                    
                    if end_idx - start_idx >= 2:
                        local_S = S_values[start_idx:end_idx]
                        local_t = time_values[start_idx:end_idx]
                        
                        # Linear fit to determine trend
                        dS_dt = np.polyfit(local_t, local_S, 1)[0]
                        
                        if dS_dt < -0.001:  # Decreasing → drying
                            self.df.loc[idx, 'sequence_type'] = 'drying'
                            self.df.loc[idx, 'surface_RH'] = RH_DRYING
                            self.df.loc[idx, 'S_surface_target'] = self.RH_to_equilibrium_S(RH_DRYING)
                        elif dS_dt > 0.001:  # Increasing → wetting
                            self.df.loc[idx, 'sequence_type'] = 'wetting'
                            self.df.loc[idx, 'surface_RH'] = RH_WETTING
                            self.df.loc[idx, 'S_surface_target'] = self.RH_to_equilibrium_S(RH_WETTING)
                        else:  # Steady state
                            self.df.loc[idx, 'sequence_type'] = 'equilibrium'
                            # Use current saturation as indicator
                            current_RH = self.estimate_RH_from_S(S_values[i])
                            self.df.loc[idx, 'surface_RH'] = current_RH
                            self.df.loc[idx, 'S_surface_target'] = S_values[i]
    
    @staticmethod
    def RH_to_equilibrium_S(RH):
        """
        Convert relative humidity to equilibrium saturation
        Using simplified Kelvin equation / sorption isotherm
        
        S_eq ≈ (RH)^n  where n depends on pore structure
        For concrete, typically n ≈ 3-5
        """
        # Simplified relationship (can be made more sophisticated)
        n_kelvin = 4.0
        S_eq = RH ** (1.0 / n_kelvin)
        return np.clip(S_eq, 0.05, 0.98)
    
    @staticmethod
    def estimate_RH_from_S(S):
        """Inverse of RH_to_equilibrium_S"""
        n_kelvin = 4.0
        RH = S ** n_kelvin
        return np.clip(RH, 0.3, 0.99)
    
    def normalize_inputs(self):
        """Normalize input features including NEW environmental features"""
        # Existing normalization
        self.time_mean = self.df['Time_d'].mean()
        self.time_std = self.df['Time_d'].std()
        self.wb_mean = self.df['w/b'].mean()
        self.wb_std = self.df['w/b'].std()
        
        self.df['Time_d_norm'] = (self.df['Time_d'] - self.time_mean) / self.time_std
        self.df['wb_norm'] = (self.df['w/b'] - self.wb_mean) / self.wb_std
        
        # Fly ash and slag
        if self.df['Fly_ash'].std() > 0:
            self.flyash_mean = self.df['Fly_ash'].mean()
            self.flyash_std = self.df['Fly_ash'].std()
            self.df['Flyash_norm'] = (self.df['Fly_ash'] - self.flyash_mean) / self.flyash_std
        else:
            self.df['Flyash_norm'] = 0.0
            
        if self.df['Slag'].std() > 0:
            self.slag_mean = self.df['Slag'].mean()
            self.slag_std = self.df['Slag'].std()
            self.df['Slag_norm'] = (self.df['Slag'] - self.slag_mean) / self.slag_std
        else:
            self.df['Slag_norm'] = 0.0
        
        # NEW: Normalize environmental RH (already in [0,1], but center it)
        self.RH_mean = self.df['surface_RH'].mean()
        self.RH_std = self.df['surface_RH'].std() if self.df['surface_RH'].std() > 0 else 1.0
        self.df['RH_norm'] = (self.df['surface_RH'] - self.RH_mean) / self.RH_std
    
    def __len__(self):
        return len(self.df)
    
    def __getitem__(self, idx):
        row = self.df.iloc[idx]
        
        # Input features for PINN
        t_norm = torch.tensor(row['Time_d_norm'], dtype=torch.float32, device=device)
        wb_norm = torch.tensor(row['wb_norm'], dtype=torch.float32, device=device)
        flyash_norm = torch.tensor(row['Flyash_norm'], dtype=torch.float32, device=device)
        slag_norm = torch.tensor(row['Slag_norm'], dtype=torch.float32, device=device)
        
        # NEW: Environmental features
        RH_norm = torch.tensor(row['RH_norm'], dtype=torch.float32, device=device)
        S_surface_target = torch.tensor(row['S_surface_target'], dtype=torch.float32, device=device)
        
        # Target integral saturation
        s_avg_target = torch.tensor(row['S_frac'], dtype=torch.float32, device=device)
        
        # Mix identifier
        mix_id = self.mix_names.index(row['Mix'])
        
        # Sequence type for analysis
        sequence_type = row['sequence_type']
        
        return {
            't_norm': t_norm,
            'wb_norm': wb_norm,
            'flyash_norm': flyash_norm,
            'slag_norm': slag_norm,
            'RH_norm': RH_norm,  # NEW
            'S_surface_target': S_surface_target,  # NEW
            's_avg_target': s_avg_target,
            'mix_id': mix_id,
            'time_days': row['Time_d'],
            'sequence_type': sequence_type  # NEW
        }


class MaterialParameters(nn.Module):
    """Learnable material parameters for each mix - UNCHANGED"""
    
    def __init__(self, n_mixes):
        super().__init__()
        self.n_mixes = n_mixes
        
        self.log_Dv = nn.Parameter(torch.randn(n_mixes) * 0.5 - 8.5)
        self.alpha0 = nn.Parameter(torch.ones(n_mixes) * 0.05 + torch.randn(n_mixes) * 0.01)
        self.nShape = nn.Parameter(torch.ones(n_mixes) * 3.0 + torch.randn(n_mixes) * 0.2)
        self.phi = nn.Parameter(torch.ones(n_mixes) * 0.15 + torch.randn(n_mixes) * 0.02)
    
    def get_parameters(self, mix_id):
        Dv = torch.exp(self.log_Dv[mix_id])
        alpha0 = torch.clamp(self.alpha0[mix_id], 0.005, 0.15)
        nShape = torch.clamp(self.nShape[mix_id], 1.2, 8.0)
        phi = torch.clamp(self.phi[mix_id], 0.05, 0.25)
        return Dv, alpha0, nShape, phi


class HybridConcreteMoisturePINN(nn.Module):
    """
    UPGRADED Physics-Informed Neural Network for BIDIRECTIONAL concrete moisture transport
    
    Key improvements:
    - Now takes environmental RH as input
    - Can model both drying and wetting
    - Input dimension increased from 5 to 6
    """
    
    def __init__(self, input_dim=6, hidden_dim=64, n_layers=5):  # Increased capacity
        super().__init__()
        
        # Slightly deeper network for hybrid behavior
        layers = [nn.Linear(input_dim, hidden_dim), nn.Tanh()]
        
        for _ in range(n_layers - 2):
            layers.extend([nn.Linear(hidden_dim, hidden_dim), nn.Tanh()])
        
        layers.append(nn.Linear(hidden_dim, 1))
        
        self.network = nn.Sequential(*layers)
        self.apply(self._init_weights)
    
    def _init_weights(self, module):
        if isinstance(module, nn.Linear):
            nn.init.xavier_normal_(module.weight)
            nn.init.zeros_(module.bias)
    
    def forward(self, x, t, wb, flyash, slag, RH):
        """
        Forward pass with NEW environmental RH input
        
        Args:
            x: spatial coordinate [0, L]
            t: time (normalized)
            wb: water/binder ratio (normalized)
            flyash: fly ash content (normalized)
            slag: slag content (normalized)
            RH: relative humidity (normalized) - NEW!
        """
        x_norm = x / DOMAIN_LENGTH
        
        # Stack inputs - NOW INCLUDING RH
        inputs = torch.stack([x_norm, t, wb, flyash, slag, RH], dim=-1)
        
        s_raw = self.network(inputs)
        s = torch.sigmoid(s_raw)
        
        return s


# Physics functions remain the same
def Dvapeur_torch(S_val, alpha0, nShape, Dv):
    S_val = torch.clamp(S_val, 1e-4, 1.0)
    fs = alpha0 + (1.0 - alpha0) / (1.0 + torch.pow((1.0 - S_val) / (1.0 - S_C), nShape))
    return torch.clamp(fs, 1e-12, 10.0) * Dv

def Dcapi_torch(S_val):
    S_val = torch.clamp(S_val, 1e-4, 1.0)
    dpc = -BETA * PC0 * torch.pow(S_val, -BETA - 1)
    return torch.abs(dpc) * K_IN / ETA_L

def D_S_torch(S_val, alpha0, nShape, Dv):
    weight = torch.sigmoid(50.0 * (S_val - S_CAP))
    return weight * Dcapi_torch(S_val) + (1.0 - weight) * Dvapeur_torch(S_val, alpha0, nShape, Dv)


class HybridConcreteMoisturePINNTrainer:
    """
    UPGRADED Trainer class for hybrid (drying + wetting) PINN
    
    Key improvements:
    - Adaptive boundary conditions based on environmental RH
    - Flexible initial conditions
    - Handles both drying and wetting physics
    """
    
    def __init__(self, dataset, domain_length=DOMAIN_LENGTH):
        self.dataset = dataset
        self.domain_length = domain_length
        
        # Initialize networks - NOTE: PINN now has 6 inputs
        self.pinn = HybridConcreteMoisturePINN().to(device)
        self.material_params = MaterialParameters(len(dataset.mix_names)).to(device)
        
        self.optimizer = optim.Adam(
            list(self.pinn.parameters()) + list(self.material_params.parameters()),
            lr=LEARNING_RATE
        )
        
        self.scheduler = optim.lr_scheduler.ExponentialLR(self.optimizer, gamma=0.995)
        self.loss_history = defaultdict(list)
        
        self.x_physics = torch.linspace(0, domain_length, N_DEPTH_POINTS, 
                                      requires_grad=True, device=device)
        
        print(f"Initialized Hybrid PINN with {sum(p.numel() for p in self.pinn.parameters())} parameters")
        print(f"Material parameters: {sum(p.numel() for p in self.material_params.parameters())} parameters")
    
    def compute_pde_residual(self, x, t, wb, flyash, slag, RH, mix_id):
        """
        Compute PDE residual - NOW with RH input
        PDE: ∂S/∂t = ∂/∂x[D(S)∂S/∂x]
        """
        x.requires_grad_(True)
        t.requires_grad_(True)
        
        n_points = x.shape[0]
        t_expanded = t.expand(n_points)
        wb_expanded = wb.expand(n_points) 
        flyash_expanded = flyash.expand(n_points)
        slag_expanded = slag.expand(n_points)
        RH_expanded = RH.expand(n_points)  # NEW
        
        # Forward pass with RH
        S = self.pinn(x, t_expanded, wb_expanded, flyash_expanded, slag_expanded, RH_expanded)
        
        Dv, alpha0, nShape, phi = self.material_params.get_parameters(mix_id)
        
        S_t = torch.autograd.grad(S, t_expanded, grad_outputs=torch.ones_like(S), 
                                create_graph=True, retain_graph=True)[0]
        
        S_x = torch.autograd.grad(S, x, grad_outputs=torch.ones_like(S), 
                                create_graph=True, retain_graph=True)[0]
        
        D_S = D_S_torch(S, alpha0, nShape, Dv)
        flux = D_S * S_x
        
        flux_x = torch.autograd.grad(flux, x, grad_outputs=torch.ones_like(flux),
                                   create_graph=True, retain_graph=True)[0]
        
        pde_residual = S_t - flux_x
        
        return pde_residual
    
    def compute_integral_loss(self, t, wb, flyash, slag, RH, mix_id, s_avg_target):
        """Compute integral data loss - NOW with RH"""
        x_integral = torch.linspace(0, self.domain_length, N_DEPTH_POINTS, device=device)
        
        t_expanded = t.expand(N_DEPTH_POINTS)
        wb_expanded = wb.expand(N_DEPTH_POINTS)
        flyash_expanded = flyash.expand(N_DEPTH_POINTS)
        slag_expanded = slag.expand(N_DEPTH_POINTS)
        RH_expanded = RH.expand(N_DEPTH_POINTS)  # NEW
        
        S_profile = self.pinn(x_integral, t_expanded, wb_expanded, flyash_expanded, slag_expanded, RH_expanded)
        
        dx = self.domain_length / (N_DEPTH_POINTS - 1)
        S_avg_pred = torch.trapz(S_profile.squeeze(), dx=dx) / self.domain_length
        
        data_loss = (S_avg_pred - s_avg_target)**2
        
        return data_loss, S_avg_pred
    
    def compute_boundary_conditions(self, t, wb, flyash, slag, RH, mix_id, S_surface_target):
        """
        UPGRADED: Adaptive boundary conditions based on environmental RH
        
        - Left boundary: S(0,t) = S_eq(RH) - equilibrium with environment
        - Right boundary: ∂S/∂x(L,t) = 0 - no flux at bottom
        
        This allows BOTH drying (low RH → low S_eq) and wetting (high RH → high S_eq)
        """
        # Left boundary: Surface saturation matches environmental equilibrium
        x_left = torch.zeros(1, device=device, requires_grad=True)
        S_left = self.pinn(x_left, t, wb, flyash, slag, RH)
        
        # Use the target surface saturation derived from RH
        bc_left_loss = (S_left - S_surface_target)**2
        
        # Right boundary: No flux at bottom (sealed or symmetry)
        x_right = torch.tensor([self.domain_length], device=device, requires_grad=True)
        S_right = self.pinn(x_right, t, wb, flyash, slag, RH)
        S_x_right = torch.autograd.grad(S_right, x_right, grad_outputs=torch.ones_like(S_right),
                                      create_graph=True, retain_graph=True)[0]
        bc_right_loss = S_x_right**2
        
        return bc_left_loss + bc_right_loss
    
    def compute_initial_condition(self, x, wb, flyash, slag, RH, mix_id, s_avg_initial):
        """
        UPGRADED: Flexible initial condition based on actual initial saturation
        
        Instead of assuming "nearly saturated", use the first measurement
        """
        n_points = x.shape[0]
        t_zero = torch.zeros(1, device=device)
        t_expanded = t_zero.expand(n_points)
        wb_expanded = wb.expand(n_points)
        flyash_expanded = flyash.expand(n_points)
        slag_expanded = slag.expand(n_points)
        RH_expanded = RH.expand(n_points)
        
        S_pred = self.pinn(x, t_expanded, wb_expanded, flyash_expanded, slag_expanded, RH_expanded)
        
        # Use actual initial saturation from data
        ic_loss = (S_pred.mean() - s_avg_initial)**2
        
        return ic_loss
    
    def train_step(self, batch):
        """Training step with NEW hybrid features"""
        self.optimizer.zero_grad()
        
        total_loss = 0.0
        pde_loss_total = 0.0
        data_loss_total = 0.0
        bc_loss_total = 0.0
        ic_loss_total = 0.0
        
        batch_size = len(batch['t_norm'])
        
        for i in range(batch_size):
            t = batch['t_norm'][i].unsqueeze(0)
            wb = batch['wb_norm'][i].unsqueeze(0)
            flyash = batch['flyash_norm'][i].unsqueeze(0)
            slag = batch['slag_norm'][i].unsqueeze(0)
            RH = batch['RH_norm'][i].unsqueeze(0)  # NEW
            S_surface_target = batch['S_surface_target'][i]  # NEW
            mix_id = batch['mix_id'][i].item()
            s_avg_target = batch['s_avg_target'][i]
            time_days = batch['time_days'][i].item()
            
            # 1. PDE residual
            pde_residual = self.compute_pde_residual(self.x_physics, t, wb, flyash, slag, RH, mix_id)
            pde_loss = torch.mean(pde_residual**2)
            
            # 2. Integral data loss
            data_loss, s_avg_pred = self.compute_integral_loss(t, wb, flyash, slag, RH, mix_id, s_avg_target)
            
            # 3. Adaptive boundary conditions
            bc_loss = self.compute_boundary_conditions(t, wb, flyash, slag, RH, mix_id, S_surface_target)
            
            # 4. Initial condition
            if abs(time_days) < 0.5:
                ic_loss = self.compute_initial_condition(self.x_physics, wb, flyash, slag, RH, mix_id, s_avg_target)
            else:
                ic_loss = torch.tensor(0.0, device=device)
            
            total_loss += (LAMBDA_PDE * pde_loss + 
                          LAMBDA_DATA * data_loss + 
                          LAMBDA_BC * bc_loss + 
                          LAMBDA_IC * ic_loss)
            
            pde_loss_total += pde_loss.item()
            data_loss_total += data_loss.item()
            bc_loss_total += bc_loss.item()
            ic_loss_total += ic_loss.item()
        
        total_loss.backward()
        
        torch.nn.utils.clip_grad_norm_(self.pinn.parameters(), max_norm=1.0)
        torch.nn.utils.clip_grad_norm_(self.material_params.parameters(), max_norm=1.0)
        
        self.optimizer.step()
        
        return {
            'total_loss': total_loss.item() / batch_size,
            'pde_loss': pde_loss_total / batch_size,
            'data_loss': data_loss_total / batch_size,
            'bc_loss': bc_loss_total / batch_size,
            'ic_loss': ic_loss_total / batch_size
        }
    
    def train(self, epochs=EPOCHS):
        """Main training loop"""
        
        def collate_fn(batch):
            batched = {}
            for key in batch[0].keys():
                if key == 'mix_id':
                    batched[key] = torch.tensor([item[key] for item in batch], dtype=torch.long)
                elif key in ['time_days', 'sequence_type']:
                    batched[key] = [item[key] for item in batch]
                else:
                    batched[key] = torch.stack([item[key] for item in batch])
            return batched
        
        dataloader = DataLoader(self.dataset, batch_size=BATCH_SIZE, shuffle=True, collate_fn=collate_fn)
        
        print("🚀 Starting HYBRID PINN training (drying + wetting)...")
        print(f"📊 Training on {len(self.dataset)} data points")
        print(f"🔄 Handling both drying and wetting sequences")
        
        best_loss = float('inf')
        patience_counter = 0
        patience = 25
        
        for epoch in range(epochs):
            epoch_start = time.time()
            
            self.pinn.train()
            self.material_params.train()
            
            epoch_losses = defaultdict(float)
            n_batches = 0
            
            for batch in dataloader:
                losses = self.train_step(batch)
                
                for key, value in losses.items():
                    epoch_losses[key] += value
                n_batches += 1
            
            for key in epoch_losses:
                epoch_losses[key] /= n_batches
                self.loss_history[key].append(epoch_losses[key])
            
            self.scheduler.step()
            
            epoch_time = time.time() - epoch_start
            current_loss = epoch_losses['total_loss']
            
            if current_loss < best_loss:
                best_loss = current_loss
                patience_counter = 0
            else:
                patience_counter += 1
            
            if epoch % 10 == 0 or epoch < 5:
                print(f"\nEpoch {epoch}/{epochs} ({epoch_time:.2f}s)")
                print(f"  Total Loss: {epoch_losses['total_loss']:.6f} {'🆕' if current_loss == best_loss else ''}")
                print(f"  PDE: {epoch_losses['pde_loss']:.6f} | Data: {epoch_losses['data_loss']:.6f}")
                print(f"  BC: {epoch_losses['bc_loss']:.6f} | IC: {epoch_losses['ic_loss']:.6f}")
                print(f"  LR: {self.optimizer.param_groups[0]['lr']:.2e}")
                
                for i, mix_name in enumerate(self.dataset.mix_names[:2]):
                    Dv, alpha0, nShape, phi = self.material_params.get_parameters(i)
                    print(f"  {mix_name}: Dv={Dv.item():.2e}, φ={phi.item():.3f}")
            
            if patience_counter >= patience:
                print(f"\n⏹️  Early stopping at epoch {epoch}")
                break
        
        print("✅ Hybrid training completed!")
        print(f"🎯 Best loss: {best_loss:.6f}")
    
    def evaluate_hybrid(self, mix_name=None, max_time_days=100):
        """
        UPGRADED evaluation showing BOTH drying and wetting capabilities
        """
        self.pinn.eval()
        self.material_params.eval()
        
        if mix_name is None:
            mix_name = self.dataset.mix_names[0]
        
        mix_id = self.dataset.mix_names.index(mix_name)
        mix_data = self.dataset.mix_groups.get_group(mix_name)
        
        print(f"\n📊 Evaluating hybrid behavior for: {mix_name}")
        
        # Separate drying and wetting data
        drying_data = mix_data[mix_data['sequence_type'] == 'drying']
        wetting_data = mix_data[mix_data['sequence_type'] == 'wetting']
        
        print(f"  Drying points: {len(drying_data)}")
        print(f"  Wetting points: {len(wetting_data)}")
        
        # Get material parameters
        Dv, alpha0, nShape, phi = self.material_params.get_parameters(mix_id)
        print(f"  Dv={Dv.item():.2e}, α₀={alpha0.item():.4f}, n={nShape.item():.2f}, φ={phi.item():.3f}")
        
        # Create comprehensive plot
        fig, axes = plt.subplots(2, 3, figsize=(18, 10))
        
        # --- Plot 1: Drying sequence ---
        if len(drying_data) > 0:
            self._plot_sequence(axes[0, 0], drying_data, mix_id, 'Drying', RH_DRYING)
        
        # --- Plot 2: Wetting sequence ---
        if len(wetting_data) > 0:
            self._plot_sequence(axes[0, 1], wetting_data, mix_id, 'Wetting', RH_WETTING)
        
        # --- Plot 3: Combined view ---
        axes[0, 2].scatter(drying_data['Time_d'], drying_data['S_frac'], 
                          color='red', s=50, label='Drying (exp)', alpha=0.7)
        axes[0, 2].scatter(wetting_data['Time_d'], wetting_data['S_frac'], 
                          color='blue', s=50, label='Wetting (exp)', alpha=0.7)
        axes[0, 2].set_xlabel('Time [days]')
        axes[0, 2].set_ylabel('Average Saturation')
        axes[0, 2].set_title(f'Hybrid Behavior - {mix_name}')
        axes[0, 2].legend()
        axes[0, 2].grid(True, alpha=0.3)
        
        # --- Plot 4: Spatial profiles for drying ---
        self._plot_spatial_profiles(axes[1, 0], mix_id, 'Drying', RH_DRYING, max_time_days)
        
        # --- Plot 5: Spatial profiles for wetting ---
        self._plot_spatial_profiles(axes[1, 1], mix_id, 'Wetting', RH_WETTING, max_time_days)
        
        # --- Plot 6: D(S) curve ---
        S_range = torch.linspace(0.01, 0.99, 100, dtype=torch.float32, device=device)
        with torch.no_grad():
            D_combined = D_S_torch(S_range, alpha0, nShape, Dv)
        
        axes[1, 2].semilogy(S_range.cpu().numpy(), D_combined.cpu().numpy(), 
                           'k-', linewidth=3, label='D(S)')
        axes[1, 2].set_xlabel('Saturation S')
        axes[1, 2].set_ylabel('Diffusion Coefficient [m²/s]')
        axes[1, 2].set_title(f'Transport Coefficient - {mix_name}')
        axes[1, 2].grid(True, alpha=0.3)
        axes[1, 2].legend()
        
        plt.tight_layout()
        plt.savefig(f'hybrid_evaluation_{mix_name}.png', dpi=150, bbox_inches='tight')
        plt.show()
        
        # Calculate R² scores
        r2_drying, r2_wetting, r2_overall = self._calculate_r2_scores(mix_data, mix_id)
        
        print(f"\n📈 Performance metrics:")
        print(f"  R² (Drying): {r2_drying:.4f}")
        print(f"  R² (Wetting): {r2_wetting:.4f}")
        print(f"  R² (Overall): {r2_overall:.4f}")
        
        return r2_overall
    
    def _plot_sequence(self, ax, seq_data, mix_id, seq_type, RH_value):
        """Helper function to plot a sequence"""
        wb_mean = seq_data['wb_norm'].mean()
        flyash_mean = seq_data['Flyash_norm'].mean()
        slag_mean = seq_data['Slag_norm'].mean()
        RH_norm = (RH_value - self.dataset.RH_mean) / self.dataset.RH_std
        
        time_days = np.linspace(seq_data['Time_d'].min(), seq_data['Time_d'].max(), 50)
        time_norm = (time_days - self.dataset.time_mean) / self.dataset.time_std
        
        s_avg_pred = []
        
        with torch.no_grad():
            for t_norm_val in time_norm:
                t_tensor = torch.tensor([t_norm_val], dtype=torch.float32, device=device)
                wb_tensor = torch.tensor([wb_mean], dtype=torch.float32, device=device)
                flyash_tensor = torch.tensor([flyash_mean], dtype=torch.float32, device=device)
                slag_tensor = torch.tensor([slag_mean], dtype=torch.float32, device=device)
                RH_tensor = torch.tensor([RH_norm], dtype=torch.float32, device=device)
                
                x_integral = torch.linspace(0, self.domain_length, N_DEPTH_POINTS, dtype=torch.float32, device=device)
                S_profile = self.pinn(x_integral, 
                                     t_tensor.expand(N_DEPTH_POINTS),
                                     wb_tensor.expand(N_DEPTH_POINTS),
                                     flyash_tensor.expand(N_DEPTH_POINTS),
                                     slag_tensor.expand(N_DEPTH_POINTS),
                                     RH_tensor.expand(N_DEPTH_POINTS))
                
                dx = self.domain_length / (N_DEPTH_POINTS - 1)
                S_avg = torch.trapz(S_profile.squeeze(), dx=dx) / self.domain_length
                s_avg_pred.append(S_avg.cpu().numpy())
        
        color = 'red' if seq_type == 'Drying' else 'blue'
        ax.plot(time_days, s_avg_pred, color=color, linewidth=2, label='PINN', alpha=0.8)
        ax.scatter(seq_data['Time_d'], seq_data['S_frac'], color=color, s=50, 
                  label='Experimental', zorder=5, edgecolors='black', linewidths=0.5)
        ax.set_xlabel('Time [days]')
        ax.set_ylabel('Average Saturation S_avg')
        ax.set_title(f'{seq_type} Sequence (RH={RH_value:.0%})')
        ax.legend()
        ax.grid(True, alpha=0.3)
    
    def _plot_spatial_profiles(self, ax, mix_id, seq_type, RH_value, max_time):
        """Helper to plot spatial saturation profiles"""
        # Use mix-average properties
        mix_data = self.dataset.mix_groups.get_group(self.dataset.mix_names[mix_id])
        wb_mean = mix_data['wb_norm'].mean()
        flyash_mean = mix_data['Flyash_norm'].mean()
        slag_mean = mix_data['Slag_norm'].mean()
        RH_norm = (RH_value - self.dataset.RH_mean) / self.dataset.RH_std
        
        plot_times = [1, 7, 28, 90]
        x_mm = np.linspace(0, self.domain_length * 1000, N_DEPTH_POINTS)
        
        with torch.no_grad():
            for plot_time in plot_times:
                if plot_time > max_time:
                    continue
                
                t_norm = (plot_time - self.dataset.time_mean) / self.dataset.time_std
                t_tensor = torch.tensor([t_norm], dtype=torch.float32, device=device)
                
                x_integral = torch.linspace(0, self.domain_length, N_DEPTH_POINTS, dtype=torch.float32, device=device)
                S_profile = self.pinn(x_integral,
                                     t_tensor.expand(N_DEPTH_POINTS),
                                     torch.tensor([wb_mean], dtype=torch.float32, device=device).expand(N_DEPTH_POINTS),
                                     torch.tensor([flyash_mean], dtype=torch.float32, device=device).expand(N_DEPTH_POINTS),
                                     torch.tensor([slag_mean], dtype=torch.float32, device=device).expand(N_DEPTH_POINTS),
                                     torch.tensor([RH_norm], dtype=torch.float32, device=device).expand(N_DEPTH_POINTS))
                
                ax.plot(x_mm, S_profile.cpu().numpy(), linewidth=2, label=f't={plot_time}d')
        
        ax.set_xlabel('Depth [mm]')
        ax.set_ylabel('Local Saturation S(x,t)')
        ax.set_title(f'{seq_type} Profiles (RH={RH_value:.0%})')
        ax.legend()
        ax.grid(True, alpha=0.3)
        ax.set_ylim(0, 1.1)
    
    def _calculate_r2_scores(self, mix_data, mix_id):
        """Calculate R² scores for drying, wetting, and overall"""
        with torch.no_grad():
            pred_values = []
            for _, row in mix_data.iterrows():
                t_tensor = torch.tensor([float(row['Time_d_norm'])], dtype=torch.float32, device=device)
                wb_tensor = torch.tensor([float(row['wb_norm'])], dtype=torch.float32, device=device)
                flyash_tensor = torch.tensor([float(row['Flyash_norm'])], dtype=torch.float32, device=device)
                slag_tensor = torch.tensor([float(row['Slag_norm'])], dtype=torch.float32, device=device)
                RH_tensor = torch.tensor([float(row['RH_norm'])], dtype=torch.float32, device=device)
                
                x_integral = torch.linspace(0, self.domain_length, N_DEPTH_POINTS, dtype=torch.float32, device=device)
                S_profile = self.pinn(x_integral,
                                     t_tensor.expand(N_DEPTH_POINTS),
                                     wb_tensor.expand(N_DEPTH_POINTS),
                                     flyash_tensor.expand(N_DEPTH_POINTS),
                                     slag_tensor.expand(N_DEPTH_POINTS),
                                     RH_tensor.expand(N_DEPTH_POINTS))
                
                dx = self.domain_length / (N_DEPTH_POINTS - 1)
                S_avg = torch.trapz(S_profile.squeeze(), dx=dx) / self.domain_length
                pred_values.append(float(S_avg.cpu().numpy()))
        
        exp_values = mix_data['S_frac'].values.astype(float)
        
        # Overall R²
        ss_res = np.sum((exp_values - np.array(pred_values))**2)
        ss_tot = np.sum((exp_values - np.mean(exp_values))**2)
        r2_overall = 1 - (ss_res / ss_tot)
        
        # Drying R²
        drying_mask = mix_data['sequence_type'] == 'drying'
        if drying_mask.sum() > 0:
            exp_dry = exp_values[drying_mask]
            pred_dry = np.array(pred_values)[drying_mask]
            r2_drying = 1 - np.sum((exp_dry - pred_dry)**2) / np.sum((exp_dry - np.mean(exp_dry))**2)
        else:
            r2_drying = np.nan
        
        # Wetting R²
        wetting_mask = mix_data['sequence_type'] == 'wetting'
        if wetting_mask.sum() > 0:
            exp_wet = exp_values[wetting_mask]
            pred_wet = np.array(pred_values)[wetting_mask]
            r2_wetting = 1 - np.sum((exp_wet - pred_wet)**2) / np.sum((exp_wet - np.mean(exp_wet))**2)
        else:
            r2_wetting = np.nan
        
        return r2_drying, r2_wetting, r2_overall
    
    def plot_loss_history(self):
        """Plot training history"""
        fig, axes = plt.subplots(2, 3, figsize=(15, 10))
        axes = axes.flatten()
        
        loss_names = ['total_loss', 'pde_loss', 'data_loss', 'bc_loss', 'ic_loss']
        
        for i, loss_name in enumerate(loss_names):
            if loss_name in self.loss_history:
                axes[i].plot(self.loss_history[loss_name], linewidth=2)
                axes[i].set_title(f'{loss_name.replace("_", " ").title()}')
                axes[i].set_xlabel('Epoch')
                axes[i].set_ylabel('Loss')
                axes[i].set_yscale('log')
                axes[i].grid(True)
        
        if len(loss_names) < len(axes):
            axes[-1].remove()
        
        plt.tight_layout()
        plt.show()


def create_hybrid_synthetic_data():
    """
    Create synthetic data with BOTH drying and wetting cycles
    """
    print("📝 Creating hybrid synthetic data (drying + wetting)...")
    
    mixes = {
        'Mix_A': {'w/b': 0.4, 'Fly_ash': 0, 'Slag': 0},
        'Mix_B': {'w/b': 0.5, 'Fly_ash': 20, 'Slag': 0},
    }
    
    data = []
    
    for mix_name, props in mixes.items():
        # DRYING PHASE: 0-90 days at 50% RH
        drying_times = [0.5, 1, 3, 7, 14, 28, 56, 90]
        for t in drying_times:
            if mix_name == 'Mix_A':
                S_frac = 0.95 * np.exp(-0.020 * t) + 0.05
            else:
                S_frac = 0.92 * np.exp(-0.015 * t) + 0.08
            
            S_frac += np.random.normal(0, 0.01)
            S_frac = np.clip(S_frac, 0.05, 1.0)
            
            data.append({
                'Mix': mix_name,
                'Time_d': t,
                'S_frac': S_frac,
                'w/b': props['w/b'],
                'Paste_density': 2100,
                'Water': 180,
                'Cement': 450,
                'Fly_ash': props['Fly_ash'],
                'Slag': props['Slag'],
                'Fine_agg': 750,
                'Coarse_agg': 1100
            })
        
        # WETTING PHASE: 91-150 days at 95% RH (reabsorption)
        # Start from the ending saturation of drying
        S_start_wet = data[-1]['S_frac']
        wetting_times = np.array([91, 98, 105, 112, 119, 126, 140, 150])
        wetting_times_normalized = wetting_times - 91  # Normalize to start of wetting
        
        for i, t in enumerate(wetting_times):
            t_wet = wetting_times_normalized[i]
            # Exponential approach to high saturation
            if mix_name == 'Mix_A':
                S_frac = 0.95 - (0.95 - S_start_wet) * np.exp(-0.03 * t_wet)
            else:
                S_frac = 0.92 - (0.92 - S_start_wet) * np.exp(-0.025 * t_wet)
            
            S_frac += np.random.normal(0, 0.01)
            S_frac = np.clip(S_frac, S_start_wet, 0.98)
            
            data.append({
                'Mix': mix_name,
                'Time_d': t,
                'S_frac': S_frac,
                'w/b': props['w/b'],
                'Paste_density': 2100,
                'Water': 180,
                'Cement': 450,
                'Fly_ash': props['Fly_ash'],
                'Slag': props['Slag'],
                'Fine_agg': 750,
                'Coarse_agg': 1100
            })
    
    df = pd.DataFrame(data)
    df.to_csv('hybrid_synthetic_concrete_data.csv', index=False)
    print(f"✅ Created hybrid dataset with {len(df)} points (drying + wetting)")
    return 'hybrid_synthetic_concrete_data.csv'


def run_hybrid_pinn_analysis(csv_file=None):
    """Main function to run hybrid PINN analysis"""
    
    if csv_file is None or not os.path.exists(csv_file):
        print("📊 Creating hybrid synthetic data...")
        csv_file = create_hybrid_synthetic_data()
    
    try:
        print(f"📥 Loading dataset from {csv_file}")
        dataset = HybridConcreteDataset(csv_file)
        
        print("🔧 Initializing Hybrid PINN trainer...")
        trainer = HybridConcreteMoisturePINNTrainer(dataset)
        
        print("🚀 Starting hybrid training...")
        trainer.train(epochs=EPOCHS)
        
        print("📊 Generating plots...")
        trainer.plot_loss_history()
        
        print("📈 Evaluating hybrid model performance...")
        r2_scores = []
        for mix_name in dataset.mix_names:
            r2 = trainer.evaluate_hybrid(mix_name, max_time_days=160)
            r2_scores.append(r2)
        
        print(f"\n✅ Hybrid analysis completed!")
        print(f"Average R² score: {np.mean(r2_scores):.4f}")
        
        # Save model
        torch.save({
            'pinn_state_dict': trainer.pinn.state_dict(),
            'material_params_state_dict': trainer.material_params.state_dict(),
            'dataset_info': {
                'mix_names': dataset.mix_names,
                'normalization_params': {
                    'time_mean': dataset.time_mean,
                    'time_std': dataset.time_std,
                    'wb_mean': dataset.wb_mean,
                    'wb_std': dataset.wb_std,
                    'RH_mean': dataset.RH_mean,
                    'RH_std': dataset.RH_std
                }
            }
        }, 'hybrid_concrete_moisture_pinn_model.pth')
        print("💾 Model saved!")
        
        return trainer, dataset
        
    except Exception as e:
        print(f"❌ Error: {str(e)}")
        raise


